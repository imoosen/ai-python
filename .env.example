# 复制本文件为 .env 后填写真实值。
# .env 已被 .gitignore 排除,不会进版本库,也不会被打进日志(C6)。

# ---- 必填 ----
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-在这里填你的key

# ---- 可选(不填用默认值) ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 单次请求超时(秒)与最大重试次数(C4)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# 成本估算单价(元/百万 token)
# 默认值 = deepseek-flash 空闲时段价,核实于 2026-10-14 官方定价页。
# 价格会变,以 https://api-docs.deepseek.com/zh-cn/quick_start/pricing 为准。
PRICE_INPUT_CACHE_HIT=0.02
PRICE_INPUT_CACHE_MISS=1.0
PRICE_OUTPUT=4.0
